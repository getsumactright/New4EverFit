---
import '../styles/fonts.css';
import '../styles/global.css';
interface Props {title?:string;description?:string;}
const {title='4Ever Fit Lifestyle — Personal coaching with Paul & Marley Urciaga',description='Your goals. Your coach. Every rep. In-person, mobile, online and posing coaching with Paul and Marley Urciaga. Request a consultation.'}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/>
<meta name="robots" content="noindex, nofollow"/>
<meta name="theme-color" content="#f4f4f1"/>
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/>
<link rel="preload" as="font" type="font/woff2" href={`${base}fonts/bebas-neue-latin-400-normal.woff2`} crossorigin/>
<link rel="preload" as="font" type="font/woff2" href={`${base}fonts/poppins-latin-400-normal.woff2`} crossorigin/>
</head><body>
<!-- THESIS: Personal coaching with champion experience, composed for everyday people.
OWN-WORLD: Off-white, ink, silver; athletic display type, crisp borders, no floating cards.
STORY: Recognize your goal, meet Paul and Marley, choose a way to train, request a conversation.
FIRST VIEWPORT: Oversized three-line headline left; warm training photograph right; clear consultation action.
FORM: User-approved editorial training studio; pinned direction overrides seed b900df93.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
<slot/>
</body></html>
