---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SilverIntro from '../components/SilverIntro.astro';
import Consultation from '../components/Consultation.astro';
import Arrow from '../components/Arrow.astro';
import {business,services} from '../config/business';
const base=import.meta.env.BASE_URL;
const pillars=[
 {name:'Nutrition',body:'Personalized nutrition guidance to support energy, recovery, and habits that fit your life.'},
 {name:'Weight & strength training',body:'Build a strong, functional body with training tailored to your experience and goals.'},
 {name:'Cardio',body:'Build stamina and support heart health with cardio suited to your starting point.'},
 {name:'Supplementation',body:'Explore supplementation as one part of your overall nutrition and training plan.'},
];
const expectations=[
 {title:'A plan with you in it.',body:'Your goals, experience, and schedule shape the conversation. You don’t need to arrive knowing all the answers.'},
 {title:'Guidance you can use.',body:'Understand what you’re working on and why. Develop confidence in your technique, one session at a time.'},
 {title:'Someone in your corner.',body:'A coaching relationship built on attention and accountability, with room for the realities of everyday life.'},
];
const faqs=[
 ['Do I need to be fit before I start?','No. You can be completely new to training or returning after a break. Your consultation is a chance to discuss your starting point and the support you’re looking for.'],
 ['Where can I train with you?',`In-person and mobile coaching are currently offered in the ${business.locations.join(' and ')} areas, subject to availability. Online coaching is also available. Tell us your location and we’ll discuss the options.`],
 ['How does online coaching work?','Fully customized online coaching is available worldwide. During your consultation, we’ll discuss your goals, equipment, routine, and the communication and support that suit you.'],
 ['Can I book a strategy meeting?','Yes. We offer dedicated 30- or 60-minute strategy meetings to discuss your goals and map out your next steps. Select Strategy meetings in the consultation form and mention your preferred length. We’ll confirm availability and details with you.'],
 ['Can I work with a Spanish-speaking coach?','Yes. Coach Paul offers coaching in both English and Spanish. Let us know your preferred language when you get in touch.'],
 ['Do I need a gym or special equipment?','Tell us what you have access to—a gym, home equipment, or a local training space. We’ll discuss what is suitable before you commit to a program.'],
 ['Is posing coaching just for competitors?','Posing coaching focuses on physique presentation and stage confidence. If you’re preparing for a competition or exploring that goal, tell us about your experience and plans.'],
 ['What happens after I request a consultation?','We’ll review your enquiry and reply by email to discuss your goals, coaching options, and current availability. Sending a request does not book a session or commit you to a training program.'],
];
---
<Layout>
<SilverIntro/>
<div id="page-shell">
<a class="skip-link" href="#main">Skip to content</a>
<Header/>
<main id="main" tabindex="-1">
<section class="hero" id="top" aria-labelledby="hero-heading">
 <div class="hero-copy">
  <h1 id="hero-heading">Your goals.<br/>Your coach.<br/><span>Every rep.</span></h1>
  <p>Personal training built around your goals, your experience, and your everyday life—with one-on-one guidance every step of the way.</p>
  <a class="button hero-button" href="#consultation">Request a consultation <Arrow/></a>
  <a class="hero-secondary" href="#trainers">Get to know Paul & Marley <span aria-hidden="true">↓</span></a>
 </div>
 <figure class="hero-visual">
  <img src={`${base}img/coaching-editorial.jpg`} alt="Illustrative coaching scene: a trainer guides a client through a kettlebell squat" width="1536" height="1024" fetchpriority="high" loading="eager"/>
  <div class="photo-caption"><span>Built around you.</span><small>Illustrative image · trainer photos coming soon</small></div>
  <div class="hero-badge"><img src={`${base}logo/badge.webp`} alt="4Ever Fit Lifestyle" width="840" height="700"/></div>
 </figure>
</section>
<div class="location-strip"><span>Personal attention. Wherever you train.</span><p>{business.locations.map(location => <>{location.split(',')[0]} <i aria-hidden="true"></i> </>)} Online</p><a href="#training">Find your fit <Arrow/></a></div>
<section class="trainers section" id="trainers">
 <div class="trainer-title"><h2>Champion experience.<br/><span class="muted-word">Everyday connection.</span></h2><p>You don’t need a stage to have a goal worth working toward.</p></div>
 <div class="trainer-story"><div class="trainer-names"><h3>Paul Urciaga</h3><span class="ampersand" aria-hidden="true">&</span><h3>Marley Urciaga</h3></div>
 <p>Founded in 2007, 4-Ever Fit is led by Paul and Marley Urciaga—a husband-and-wife fitness and wellness coaching team. Natural bodybuilding champions, INBA / PNBA judges, and Hall of Fame inductees, they bring experience from the stage to your everyday goals.</p>
 <p>Paul brings 37 years of client training experience; Marley brings 18. Together, they support lifestyle changes, strength and fitness goals, competition preparation, and confident stage presentation.</p>
 <p class="coach-language">Coaching in English and Spanish with Coach Paul. <span lang="es">¡Se habla español!</span></p>
 <div class="credentials"><span>Multiple first-place bodybuilding & fitness titles</span><span>INBA / PNBA Judges</span><span>Natural Bodybuilding Hall of Fame Inductees</span></div>
 <div class="social-links"><a class="text-link" href={business.instagram} target="_blank" rel="noopener noreferrer">Meet them on Instagram <Arrow/></a><a class="text-link" href={business.tiktok} target="_blank" rel="noopener noreferrer">Watch them on TikTok <Arrow/></a></div></div>
</section>
<section class="training section" id="training">
 <div class="section-heading"><h2>Find your<br/><span class="muted-word">way to train.</span></h2><p>Different starting points. Different schedules.<br/>One commitment to personal coaching.</p></div>
 <div class="service-list">{services.map(service=><article class="service-row"><div><h3>{service.name}</h3><span class="service-detail">{service.detail}</span></div><div class="service-description"><h4>{service.tag}</h4><p>{service.description}</p></div><a class="service-link" href="#consultation" data-service={service.name} aria-label={`Ask about ${service.name.toLowerCase()}`}><Arrow/></a></article>)}</div>
 <p class="availability">In-person and mobile availability currently varies between {business.locations.join(' and ')}. Ask us what’s available near you.</p>
</section>
<section class="method section" aria-labelledby="method-heading">
 <div class="method-intro"><h2 id="method-heading">More than<br/><span>the workout.</span></h2><p>Looking fit is only half the equation. Our goal is to help you feel better, support your overall well-being, and build a vibrant lifestyle you can sustain. Four core components guide the approach:</p><img class="method-badge" src={`${base}logo/badge.webp`} alt="Four-pillar 4Ever Fit badge" width="840" height="700" loading="lazy"/></div>
 <div class="pillar-list">{pillars.map(p=><div class="pillar"><h3>{p.name}</h3><p>{p.body}</p></div>)}<a class="text-link" href="#consultation">Let’s talk about your goals <Arrow/></a></div>
 <span class="method-watermark" aria-hidden="true">4EVER</span>
</section>
<section class="experience section" id="experience"><div class="section-heading"><h2>Real life.<br/><span class="muted-word">Real support.</span></h2><p>What to expect from your coaching.</p></div><div class="expectations">{expectations.map((item)=><article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
<section class="faq section" id="faqs"><div><h2>A little clarity.<br/><span class="muted-word">Before you start.</span></h2><p>Still have a question?<br/><a class="text-link" href="#consultation">Let’s talk <Arrow/></a></p></div><div class="faq-list">{faqs.map(([question,answer])=><details name="faq"><summary>{question}<span class="faq-icon" aria-hidden="true"></span></summary><p>{answer}</p></details>)}</div></section>
<Consultation/>
</main>
<Footer/>
<a class="mobile-consultation button" href="#consultation" hidden>Request a consultation <Arrow/></a>
</div>
<script>
const sticky=document.querySelector<HTMLElement>('.mobile-consultation');
const hero=document.querySelector('.hero');
const consultation=document.getElementById('consultation');
const footer=document.querySelector('.site-footer');
if(sticky && hero && consultation && footer){
 let heroVisible=true,formVisible=false,footerVisible=false;
 const observer=new IntersectionObserver(entries=>{for(const e of entries){if(e.target===hero)heroVisible=e.isIntersecting;if(e.target===consultation)formVisible=e.isIntersecting;if(e.target===footer)footerVisible=e.isIntersecting;}sticky.hidden=heroVisible||formVisible||footerVisible;});
 [hero,consultation,footer].forEach(el=>observer.observe(el));
}
</script>
</Layout>
