  <script>
    // Intro handoff — the badge arrives full-viewport, then the overlay
    // fades while the (now larger) hero badge pops in at the same moment.
    // Both are the same transparent PNG on the same ink ground, so it
    // reads as one object settling into place. Once per session
    // (sessionStorage), skippable, and fully reduced-motion safe: with
    // reduced motion the overlay never shows and the hero badge is simply
    // visible from the start — the hero itself is real, readable content
    // underneath the whole time, never gated behind the intro.
    const SEEN_KEY = '4everfit-intro-seen';
    // The clip is 3.63s. The failsafe covers browsers that never fire
    // 'ended' — a stalled video must not leave the page behind a black
    // rectangle forever.
    const CLIP_MS = 3700;
    const overlay = document.getElementById('intro-overlay');
    const video = document.getElementById('intro-video') as HTMLVideoElement | null;
    const skipBtn = document.getElementById('intro-skip');
    const heroBadges = document.querySelectorAll<HTMLElement>('[data-hero-badge]');
    const prefersReducedIntro = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const alreadySeen = (() => {
      try {
        return sessionStorage.getItem(SEEN_KEY) === '1';
      } catch {
        return false;
      }
    })();

    function landHero() {
      heroBadges.forEach((el) => el.classList.add('is-landed'));
    }

    function finishIntro() {
      if (overlay) {
        overlay.classList.add('intro-done');
        document.body.style.overflow = '';
        window.setTimeout(() => overlay.remove(), 700);
      }
      landHero();
      try {
        sessionStorage.setItem(SEEN_KEY, '1');
      } catch {
        /* private browsing — fine to skip persisting */
      }
    }

    if (!overlay || !video || prefersReducedIntro || alreadySeen) {
      overlay?.remove();
      landHero();
    } else {
      document.body.style.overflow = 'hidden';
      let handedOff = false;
      const handOff = () => {
        if (handedOff) return;
        handedOff = true;
        finishIntro();
      };
      video.addEventListener('ended', handOff);
      // Autoplay can still be refused (data saver, low power mode, a policy
      // that ignores muted). Sitting on a black rectangle would be worse
      // than no intro, so a refused play skips straight to the page.
      const attempt = video.play();
      if (attempt && typeof attempt.catch === 'function') attempt.catch(handOff);
      video.addEventListener('error', handOff);
      window.setTimeout(handOff, CLIP_MS + 900);
      skipBtn?.addEventListener('click', handOff);
    }
  </script>

  <script>
    // Lightweight reveal-on-scroll — staggered per item, honors reduced motion.
    // Content is visible by default (no class-gated hidden state), so this
    // only enhances an already-rendered page.
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced && 'IntersectionObserver' in window) {
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const delay = Number(el.dataset.revealDelay ?? 0) * 80;
              el.style.transitionDelay = `${delay}ms`;
              el.classList.add('is-revealed');
              io.unobserve(el);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      items.forEach((el) => {
        el.classList.add('reveal-init');
        io.observe(el);
      });
    }
  </script>

  <style is:global>
    #intro-overlay {
      /* True black, to match the clip's crushed ground exactly. The shipped
         encode has its black point pulled down so the studio vignette that
         used to halo the badge resolves to zero: measured across every frame
         after 1.25s, the clip's own edges peak at 5/255 and average 0.5, so
         the square it lives in has no visible boundary. */
      background-color: #000000;
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .intro-skip {
      /* On the clip's black ground the page's muted grey is nearly invisible,
         so the skip control is drawn against the video, not the theme. */
      color: rgba(255, 255, 255, 0.62);
    }
    .intro-skip:hover,
    .intro-skip:focus-visible {
      color: #FFFFFF;
    }
    /* The clip is a 960x960 square, sized as an object on the overlay rather
       than stretched to fill it. Filling meant 900px tall on a 1440x900
       desktop, which read as a video takeover rather than a mark arriving.

       Three caps, smallest wins: 62vw keeps it clear of the edges on a
       phone (242px at 390px wide), 58vh stops it colliding with the top and
       bottom in landscape, and 440px is the ceiling on any large screen —
       roughly half the old height, and the same footprint the CSS intro
       used. At the 440px ceiling a 2x screen asks for 880 device px, so the
       960 source still has pixels in hand and stays crisp. */
    .intro-stage {
      position: relative;
      width: min(62vw, 58vh, 440px);
      aspect-ratio: 1 / 1;
    }
    .intro-video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    /* The crushed encode makes the frame edge vanish on its own from 1.25s
       on. Before that the barbell is larger than the frame and runs off it —
       measured, its edge brightness sits at 150-240 until 1.20s, then drops
       to zero — and a hard straight cut across metal mid-screen is the one
       thing the crush cannot fix. So the outer 7% still feathers, purely to
       soften that early overrun. It costs nothing later: by 1.25s the
       content is entirely inside the frame and there is nothing left to
       fade. 7% and no more, because the barbell tip reaches 98% of the
       frame width while assembling. */
    .intro-stage::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(to right, #000 0%, rgba(0, 0, 0, 0) 7%, rgba(0, 0, 0, 0) 93%, #000 100%),
        linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0) 7%, rgba(0, 0, 0, 0) 93%, #000 100%);
    }
    #intro-overlay.intro-done {
      opacity: 0;
      pointer-events: none;
    }

    /* Hero badge starts small/invisible and pops in the instant the intro
       hands off. With a video intro this is the only arrival there is — the
       clip cannot be flown onto the hero badge the way the CSS badge was.
       It settles from 0.94 rather than the original 0.55:
       an 82% size jump read as a pop, which is at odds with a brand
       PRODUCT.md describes as "confident and calm" and with DESIGN.md's
       ease-out-only motion rule. The badge should look like it is arriving,
       not inflating. */
    .hero-badge {
      opacity: 0;
      transform: scale(0.94);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-badge.is-landed {
      opacity: 1;
      transform: scale(1);
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-badge {
        transition: none;
      }
    }

    [data-reveal].reveal-init {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    [data-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }

    .store-badge {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 1px;
      padding: 9px 18px;
      border-radius: var(--radius-sm);
      border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
      color: var(--color-ink);
      line-height: 1.15;
      transition: border-color 0.2s ease-out, background-color 0.2s ease-out;
    }
    .store-badge:hover {
      border-color: var(--color-accent);
      background: var(--color-surface-muted);
    }
    .store-badge-eyebrow {
      font-size: 10px;
      color: var(--color-muted);
    }
    .store-badge-name {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 15px;
      letter-spacing: 0.02em;
    }
  </style>
</Layout>
